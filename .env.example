# Do not put your actual password in GitHub or share it in chat.
PORT=3000
DATA_DIR=./data
# Set these privately in your hosting environment settings:
# ADMIN_EMAIL=your-email-address
# ADMIN_PASSWORD=your-own-strong-password-at-least-12-characters
# NODE_ENV=production
# BASE_DOMAIN=yourdomain.com
# Public origin used for email links; never derived from browser request headers.
# APP_URL=https://digitaldukan-production.up.railway.app
# RESEND_API_KEY=enter-privately-in-hosting-settings
# MAIL_FROM=Digital Dukan <onboarding@resend.dev>
# Test sender only delivers to your Resend account email. Use a verified
# sender domain for other recipients before public launch.
# AUTO_BACKUPS=true
# BACKUP_KEEP=3
# BACKUP_DIR defaults to DATA_DIR/backups; use a private persistent location.

# Email verification is temporarily paused by default. Password reset stays enabled.
# EMAIL_VERIFICATION_ENABLED=true
